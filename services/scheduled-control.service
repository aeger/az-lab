[Unit]
Description=Scheduled Activity Control Daemon — reconcile registry → native
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u %h/azlab/scripts/scheduled_control_daemon.py
Restart=on-failure
RestartSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scheduled-control

# Daemon needs to manipulate user systemd units + crontab — already runs
# in the user systemd manager scope, so no extra capabilities needed.
Environment=POLL_INTERVAL=30

[Install]
WantedBy=default.target
