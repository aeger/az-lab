[Unit]
Description=Daily check that episodic-distill actually ran and succeeded

[Timer]
# 03:30 UTC — 30 min after episodic-distill.service fires at 03:00 UTC
# (a healthy run takes ~52s, so this leaves ample margin).
OnCalendar=*-*-* 03:30:00 UTC
Persistent=true
Unit=episodic-distill-healthcheck.service

[Install]
WantedBy=timers.target
