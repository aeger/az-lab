[Unit]
Description=Weekly memory injection retro-scan / pattern-version rescan (OWASP ASI06 point 4)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/almty1/azlab/services/memory-mcp-server
EnvironmentFile=/home/almty1/azlab/services/memory-mcp-server/.env
ExecStart=/usr/bin/python3 /home/almty1/azlab/services/memory-mcp-server/injection_scan.py
StandardOutput=append:/home/almty1/azlab/services/memory-mcp-server/injection_scan.log
StandardError=append:/home/almty1/azlab/services/memory-mcp-server/injection_scan.log
