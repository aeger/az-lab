[Unit]
Description=Claude Code Task Queue Poller
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Invoke through the interpreter explicitly. Since 2026-08-16 the installed path
# is a symlink to the repo file, and the repo file is mode 644 — relying on the
# shebang + exec bit would break the poller the first time install.sh ran.
ExecStart=/usr/bin/python3 %h/claude-queue/poll_queue.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=claude-queue-poll

# Uncomment if claude is not on PATH
# Environment=CLAUDE_CMD=%h/.local/bin/claude

[Install]
WantedBy=default.target
